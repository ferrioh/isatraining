{
  "name": "isa-training",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "ISA TRAINING - React + TypeScript + WebSocket realtime (Vercel ready)",
  "scripts": {
    "dev": "concurrently -k -n web,ws -c magenta,cyan \"vite\" \"node server/ws-server.mjs\"",
    "dev:web": "vite",
    "dev:ws": "node server/ws-server.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "ws": "node server/ws-server.mjs",
    "start": "node server/prod-server.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "motion": "^14.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
